.env
# Comptes, sessions, groupes et planification : données du volume, pas du code.
# Recréés au démarrage par migrate_multi_groupes().
data/teachers.json
data/prof_sessions.json
data/groups.json
# Réseau multi-centres : l'arbre et la table des accès sont des données du
# volume, comme les comptes et les groupes — jamais du code versionné.
data/organisations.json
data/acces.json
data/audit.json
data/invitations.json
data/stats_jour.json
data/schedule.json
# La liste des élèves appartient au groupe, donc au volume comme lui. Le
# dépôt n'en contenait qu'une liste vide ; `load_students()` en fait autant
# quand le fichier manque.
data/students.json
# Fichiers partagés à un groupe : métadonnées et fichiers déposés par
# l'enseignant, donc du volume et non du code.
data/documents.json
assets/documents-groupe/
# Cumul de pratique de « Corrige-moi ! », un enregistrement par (élève, thème).
# Trace d'élève, donc du volume — comme le CLAUDE.md le dit déjà.
data/corrige_moi.json
# Dépôts de matériel des enseignants : fichiers téléversés et leurs
# métadonnées. Du volume, pas du code — contrairement à data/materiel.json,
# qui est produit par le build et versionné.
data/depots.json
assets/depots/
data/promotions.json
# Caches de traduction : payés une fois, reconstruits à l'usage.
# Données du volume, pas du code.
data/traductions.json
data/outils_cache.json
data/voix-cache/
__pycache__/
*.pyc
.DS_Store
build/powerpoints/_apercu/
build/powerpoints/_captures/

# /design-sync
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
assets/design-system-react/node_modules/
assets/design-system-react/dist/
# Productions écrites déposées par les élèves : trace d'élève, donc du volume.
data/written_submissions.json
# Boîtes de répétition espacée du vocabulaire : trace d'élève, comme ci-dessus.
data/vocab_progress.json
# Enregistrements oraux déposés : les fichiers vivent sur le volume.
assets/oral-submissions/
# Classe de démonstration (build/demo_traces.py) : voix de synthèse produites
# pour les présentations, et sauvegarde des traces réelles d'avant la pose.
build/demo-voix/
data/_sauvegarde-avant-demo/
# Même chose pour la classe de présentation (build/demo_classe.py).
build/demo-voix-classe/
data/_sauvegarde-avant-demo-classe/
# Atelier de rendu du teaser : 1 553 images intermédiaires, le montage et son
# node_modules. Sortie de build, comme les aperçus de PowerPoint ci-dessus —
# le dépôt n'a pas à porter 119 Mo qui se régénèrent.
build/teaser/
# Les MP3 de la voix « enseignante » avant ralentissement (voir voix_lente.py).
# Copie de secours locale : le dépôt garde déjà les originaux dans son
# historique, inutile d'y ajouter 27 Mo de doublons.
.audio-originaux/
# Signalements des enseignants (« Outil en développement ») : ce que le
# portail reçoit en ligne, donc du volume — comme les productions déposées.
data/signalements.json
planche-images.html
build/_contexte_images.json
essai-voix/
essai-voix.html
essai-debit/
essai-debit.html
essai-lettres/
essai-lettres.html
essai-brin/
essai-brin.html
